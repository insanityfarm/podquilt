{
    "id": "repo-governance-context-system",
    "title": "Repo governance and anti-drift context system",
    "status": "stable",
    "summary": "Owns repository-wide workflow rules, anti-drift tooling, generated context artifacts, and contributor-facing maps that explain how to use them.",
    "owned_paths": [
        ".dockerignore",
        ".github/**",
        ".gitignore",
        ".htaccess",
        ".php-cs-fixer.dist.php",
        "AGENTS.md",
        "Dockerfile",
        "LICENSE",
        "README.md",
        "compose.yaml",
        "composer.json",
        "composer.lock",
        "docs/**",
        "glossary/**",
        "phpstan.neon",
        "phpunit.xml",
        "spec/**",
        "tests/ContextSystemTest.php",
        "tools/context-system/**"
    ],
    "related_paths": [],
    "entrypoints": [
        {
            "path": "tools/context-system/bin/build.php",
            "symbols": [
                "context:build"
            ]
        },
        {
            "path": "tools/context-system/bin/task.php",
            "symbols": [
                "context:task"
            ]
        },
        {
            "path": "tools/context-system/bin/check.php",
            "symbols": [
                "context:check"
            ]
        }
    ],
    "depends_on": [],
    "used_by": [],
    "required_reads": {
        "spec": [
            "spec/README.md",
            "spec/tooling-and-quality.md"
        ],
        "docs": [
            "docs/context-system/README.md",
            "docs/repo-workflow/README.md"
        ],
        "decisions": [
            "spec/decisions/ADR-0001-anti-drift-context-system.md",
            "spec/decisions/ADR-0002-locked-subsystem-edit-policy.md",
            "spec/decisions/ADR-0003-local-only-anti-drift-enforcement-and-composer-verify.md"
        ]
    },
    "glossary_terms": [
        "authoritative artifact",
        "derived artifact",
        "active task packet",
        "locked subsystem"
    ],
    "public_contracts": [
        {
            "name": "composer context:build",
            "summary": "Regenerates tracked context artifacts from structured JSON source files."
        },
        {
            "name": "composer context:task -- \"<task>\"",
            "summary": "Writes the repo-local active task packet and prints a bounded task brief."
        },
        {
            "name": "composer verify",
            "summary": "Runs the local verification flow that includes code quality and anti-drift checks."
        }
    ],
    "invariants": [
        {
            "id": "gov-ctx-001",
            "statement": "AGENTS.md stays intentionally thin and routes readers to authoritative artifacts."
        },
        {
            "id": "gov-ctx-002",
            "statement": "Context build output is derived and must be regenerated from JSON source files."
        },
        {
            "id": "gov-ctx-003",
            "statement": "Local anti-drift verification is authoritative, while CI remains a narrower code-health gate."
        },
        {
            "id": "gov-ctx-004",
            "statement": "Every first-party file listed by the subsystem index must be owned by at least one subsystem."
        }
    ],
    "performance_constraints": [
        "Context artifacts stay compact enough for task briefing without requiring broad repo reads."
    ],
    "change_policy": {
        "default": "additive-with-validation",
        "requires_adr": [
            "changing active-task enforcement semantics",
            "moving authoritative artifact homes",
            "changing the local-only verification contract"
        ]
    },
    "tests": [
        "tests/ContextSystemTest.php"
    ],
    "decision_refs": [
        "ADR-0001",
        "ADR-0002",
        "ADR-0003"
    ],
    "history_anchors": {
        "introduced_by": "2026-03-30-anti-drift-adoption",
        "major_refactors": []
    }
}
