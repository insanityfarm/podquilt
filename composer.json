{
    "name": "insanityfarm/podquilt",
    "description": "Merge multiple podcast feeds into a single personal RSS feed.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "dragonmantank/cron-expression": "^3.6",
        "symfony/http-client": "^8.0"
    },
    "require-dev": {
        "nikic/php-parser": "^5.7",
        "php-cs-fixer/shim": "^3.93",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Podquilt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Podquilt\\Tests\\": "tests/",
            "Podquilt\\Tools\\ContextSystem\\": "tools/context-system/src/"
        }
    },
    "scripts": {
        "serve": "@php -S 0.0.0.0:8000 -t .",
        "test": "phpunit --configuration phpunit.xml",
        "analyse": "phpstan analyse --configuration phpstan.neon --memory-limit=1G",
        "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes",
        "context:build": "@php tools/context-system/bin/build.php",
        "context:task": "@php tools/context-system/bin/task.php",
        "context:check": "@php tools/context-system/bin/check.php",
        "terms:check": "@php tools/context-system/bin/terms.php",
        "comments:check": "@php tools/context-system/bin/comments.php",
        "arch:check": "@php tools/context-system/bin/architecture.php",
        "drift:review": "@php tools/context-system/bin/review.php",
        "check": [
            "@test",
            "@analyse",
            "php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes --dry-run --diff"
        ],
        "verify": [
            "@check",
            "@terms:check",
            "@comments:check",
            "@arch:check",
            "@context:check"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
